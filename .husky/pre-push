# Full checks before pushing, so failures surface locally before a pull request.
# Bypass with: git push --no-verify

cd "$(git rev-parse --show-toplevel)" || exit 1

npm --prefix src/frontend run lint || exit 1

if command -v mvn >/dev/null 2>&1; then
  mvn -B test || exit 1
else
  echo "warning: mvn not found, skipping backend tests"
fi
